# IG Markets API Configuration
# Copy this file to .env and fill in your credentials

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# IG Markets API Credentials
# Get your API key from: https://labs.ig.com/
IG_API_KEY=your-api-key-here
IG_USERNAME=your-username-here
IG_PASSWORD=your-password-here

# Use demo account (True) or live account (False)
IG_DEMO=True
